{
    "name": "systemverk/laravel-api-telemetry",
    "description": "A Laravel package for API request telemetry, providing Redis-backed collection, aggregation and persistence of API request metrics and per-actor usage statistics.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "telemetry",
        "api",
        "metrics",
        "monitoring",
        "redis",
        "logging",
        "analytics"
    ],
    "authors": [
        {
            "name": "Eirik Halvorsen",
            "email": "eirik386@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/systemverk/laravel-api-telemetry/issues",
        "source": "https://github.com/systemverk/laravel-api-telemetry"
    },
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0|^12.0",
        "illuminate/contracts": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/redis": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^9.0|^10.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "suggest": {
        "ext-redis": "Recommended Redis client for production throughput (alternative: predis/predis).",
        "predis/predis": "Pure PHP Redis client, usable when ext-redis is unavailable."
    },
    "autoload": {
        "psr-4": {
            "Systemverk\\LaravelApiTelemetry\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Systemverk\\LaravelApiTelemetry\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=512M",
        "test": "phpunit",
        "ci": [
            "@composer validate --strict",
            "@analyse",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Systemverk\\LaravelApiTelemetry\\ApiTelemetryServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
